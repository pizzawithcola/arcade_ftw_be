# Signs the bearer tokens; must match between deploys or everyone gets logged out.
SECRET_KEY=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

CORS_ORIGINS=http://localhost:5070

DB_HOST=localhost
# 5433 maps to the Postgres container from docker-compose.yml. A local Postgres
# often already owns 5432, so the compose file deliberately avoids it.
DB_PORT=5433
DB_NAME=arcade_ftw
DB_USER=arcade_ftw
DB_PASSWORD=arcade_ftw
